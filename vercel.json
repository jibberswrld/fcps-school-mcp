{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/mcp/:key",
      "destination": "/api/mcp?key=:key"
    }
  ]
}
